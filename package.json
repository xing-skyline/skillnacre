{
  "name": "skillnacre",
  "version": "1.1.0",
  "description": "SkillNacre · 技能匣 — 统一管理你的 AI 技能",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "author": "SkillNacre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xing-skyline/skillnacre.git"
  },
  "bugs": "https://github.com/xing-skyline/skillnacre/issues",
  "homepage": "https://github.com/xing-skyline/skillnacre#readme",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "electron .",
    "build": "vite build",
    "notices": "node scripts/generate-notices.mjs",
    "screenshots": "node tests/capture-demo.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/desktop-smoke.mjs",
    "pack": "npm run notices && npm run build && electron-builder --win dir",
    "dist": "npm run notices && npm run build && electron-builder --win nsis portable"
  },
  "build": {
    "appId": "local.skillnacre.desktop",
    "productName": "SkillNacre",
    "directories": {
      "output": "release"
    },
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.skillnacre.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "core/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SkillNacre 技能匣",
      "artifactName": "SkillNacre-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SkillNacre-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "json5": "2.2.3",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "prettier": "3.9.6",
    "vite": "8.3.0"
  }
}
